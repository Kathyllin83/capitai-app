<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS obrigatorio em todo o app. Espelha `cleartext: false`
  do capacitor.config.ts no nivel da plataforma Android.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
